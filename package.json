{
  "name": "@homestuck/platform",
  "private": true,
  "description": "A monorepo of shared configurations, published packages, and applications maintained by Homestuck Inc., et al.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "vp build",
    "clean": "git clean -xdf node_modules",
    "clean:workspaces": "turbo clean",
    "dev": "vp dev",
    "format": "vp fmt --check",
    "format:fix": "vp fmt",
    "lint": "vp lint",
    "lint:fix": "vp lint --fix",
    "precommit": "lint-staged",
    "preinstall": "pnpm dlx only-allow pnpm",
    "typecheck": "turbo typecheck"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@commitlint/config-pnpm-scopes": "^21.2.2",
    "@homestuck/oxfmt-config": "workspace:^",
    "@homestuck/oxlint-config": "workspace:^",
    "@homestuck/tsconfig": "workspace:^",
    "@shadcn/lint": "catalog:",
    "@turbo/gen": "^2.11.10",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint-plugin-react-you-might-not-need-an-effect": "catalog:",
    "eslint-plugin-regexp": "catalog:",
    "lint-staged": "^17.6.0",
    "turbo": "^2.11.10",
    "typescript": "catalog:",
    "vite-plus": "catalog:"
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional",
      "@commitlint/config-pnpm-scopes"
    ]
  },
  "engines": {
    "node": ">=24.22.1 || >=26.13.0"
  },
  "packageManager": "pnpm@12.16.1"
}
