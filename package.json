{
  "name": "@homestuck/platform",
  "private": true,
  "description": "A monorepo of shared configurations, published packages, and applications maintained by Homestuck Inc., et al.",
  "type": "module",
  "scripts": {
    "build": "vp build",
    "check": "vp check",
    "clean": "git clean -xdf node_modules",
    "clean:workspaces": "turbo clean",
    "dev": "vp dev",
    "format": "vp fmt --check",
    "format:fix": "vp fmt",
    "lint": "vp lint",
    "lint:fix": "vp lint --fix",
    "precommit": "lint-staged",
    "preinstall": "pnpm dlx only-allow pnpm",
    "prepare": "husky",
    "typecheck": "turbo typecheck"
  },
  "devDependencies": {
    "@changesets/cli": "catalog:",
    "@commitlint/cli": "catalog:",
    "@commitlint/config-conventional": "catalog:",
    "@commitlint/config-pnpm-scopes": "catalog:",
    "@homestuck/oxfmt-config": "workspace:^",
    "@homestuck/oxlint-config": "workspace:^",
    "@homestuck/tsconfig": "workspace:^",
    "@shadcn/lint": "catalog:",
    "@turbo/gen": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "eslint-plugin-react-you-might-not-need-an-effect": "catalog:",
    "eslint-plugin-regexp": "catalog:",
    "eslint-plugin-turbo": "catalog:",
    "husky": "catalog:",
    "lint-staged": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:",
    "vite-plus": "catalog:"
  },
  "lint-staged": {
    "*": "oxfmt --no-error-on-unmatched-pattern",
    "*.{js,jsx,ts,tsx,cjs,mjs}": "pnpm run lint"
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional",
      "@commitlint/config-pnpm-scopes"
    ]
  },
  "engines": {
    "node": ">=24.10.x"
  },
  "packageManager": "pnpm@12.14.0"
}
