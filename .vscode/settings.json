{
  "[javascript]": {
    "editor.defaultFormatter": "oxc.oxc-vscode"
  },
  "[javascriptreact]": {
    "editor.defaultFormatter": "oxc.oxc-vscode"
  },
  "[svg]": {
    "editor.defaultFormatter": "redhat.vscode-xml"
  },
  "[typescript]": {
    "editor.defaultFormatter": "oxc.oxc-vscode"
  },
  "[typescriptreact]": {
    "editor.defaultFormatter": "oxc.oxc-vscode"
  },
  "cSpell.words": [
    "Alternian",
    "cmdk",
    "commitlint",
    "esbuild",
    "griftress",
    "imode",
    "lookarounds",
    "lucide",
    "nextjs",
    "nonconstructor",
    "nonoctal",
    "oxfmtcache",
    "oxlintcache",
    "rightsholders",
    "sonner",
    "swatchbook",
    "tavvy",
    "topo",
    "tsgolint",
    "unpunnyfuns",
    "vite",
    "voidzero",
    "vrissy"
  ],
  "debug.console.closeOnEnd": true,
  "editor.codeActionsOnSave": {
    "source.fixAll.oxc": "explicit"
  },
  "editor.defaultFormatter": "oxc.oxc-vscode",
  "editor.formatOnSave": true,
  "editor.formatOnSaveMode": "file",
  "editor.tabSize": 2,
  "files.exclude": {
    "**/.DS_Store": true,
    "**/.cache": true,
    "**/.git": true,
    "**/.husky/_": true,
    "**/.next": true,
    "**/.parcel-cache": true,
    "**/.turbo": true,
    "**/.vite-hooks/_": true,
    "**/Thumbs.db": true,
    "**/node_modules": true
  },
  "files.insertFinalNewline": true,
  "js/ts.experimental.useTsgo": true,
  "js/ts.tsdk.path": "node_modules/typescript",
  "js/ts.tsdk.promptToUseWorkspaceVersion": true,
  "oxc.disableNestedConfig": true,
  "oxc.enable.oxfmt": true,
  "oxc.enable.oxlint": true,
  "oxc.enable": true,
  "oxc.fmt.disableNestedConfig": true,
  "oxc.requireConfig": true,
  "oxc.trace.server": "verbose",
  "tailwindCSS.classAttributes": ["class", "className", "ngClass", "class:list"],
  "tailwindCSS.classFunctions": ["clsx", "cn", "cva", "tw", "twMerge"],
  "tailwindCSS.experimental.configFile": {
    "apps/design-system/src/styles/globals.css": "packages/design-system/**",
    "packages/styles/src/styles/tailwind/globals.css": "packages/styles/src/**",
    "packages/ui/src/styles/globals.css": "packages/ui/src/**"
  }
}
