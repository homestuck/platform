{
  "name": "@homestuck/ui",
  "version": "0.0.0-alpha.0",
  "private": false,
  "description": "UI components, hooks, and styles used and maintained by Homestuck Inc., et al.",
  "type": "module",
  "imports": {
    "#components/*": "./src/components/*.tsx",
    "#hooks/*": "./src/hooks/*.ts",
    "#ui/*": "./src/components/*.tsx"
  },
  "exports": {
    "./components/*": "./src/components/*.tsx",
    "./hooks/*": "./src/hooks/*.ts",
    "./styles/globals.css": "./src/styles/globals.css"
  },
  "scripts": {
    "add": "pnpm dlx shadcn-ui add",
    "clean": "rm -rf .turbo node_modules",
    "format": "vp fmt",
    "lint": "vp lint",
    "typecheck": "tsc --noEmit --emitDeclarationOnly false"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@homestuck/styles": "workspace:^",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.5.0",
    "date-fns": "^4.4.0",
    "lucide-react": "catalog:",
    "next-themes": "^0.4.6",
    "react": "catalog:",
    "react-day-picker": "^10.0.2",
    "react-dom": "catalog:",
    "react-hook-form": "^7.91.0",
    "sonner": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@homestuck/oxlint-config": "workspace:^",
    "@homestuck/tsconfig": "workspace:^",
    "next": "catalog:",
    "oxlint": "catalog:",
    "tailwindcss": "catalog:",
    "tw-animate-css": "catalog:"
  }
}
