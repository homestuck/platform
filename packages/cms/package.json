{
  "name": "@homestuck/cms",
  "version": "0.0.0-alpha.0",
  "private": false,
  "type": "module",
  "imports": {
    "#access/*": "./src/access/*.ts",
    "#fields/*": "./src/fields/*/index.ts",
    "#payload.types": "./src/payload.types.ts",
    "#payload.config": "./src/payload.config.ts",
    "#i18n": "./src/i18n/index.ts",
    "#utils/*": "./src/utils/*.ts"
  },
  "exports": {
    "./payload.config": "./src/payload.config.ts",
    "./payload.types": "./src/payload.types.ts",
    "./components/admin": "./src/components/admin/index.ts",
    "./components/*": "./src/components/*.tsx",
    "./blocks/*": "./src/blocks/*.tsx"
  },
  "scripts": {
    "clean": "rm -rf .turbo node_modules",
    "format": "vp fmt",
    "generate:types": "payload generate:types",
    "lint": "vp lint",
    "typecheck": "tsc --noEmit --emitDeclarationOnly false"
  },
  "dependencies": {
    "@homestuck/env": "workspace:^",
    "@homestuck/utils": "workspace:^",
    "@payloadcms/admin-bar": "catalog:payload",
    "@payloadcms/db-mongodb": "catalog:payload",
    "@payloadcms/graphql": "catalog:payload",
    "@payloadcms/next": "catalog:payload",
    "@payloadcms/plugin-form-builder": "catalog:payload",
    "@payloadcms/plugin-search": "catalog:payload",
    "@payloadcms/plugin-seo": "catalog:payload",
    "@payloadcms/richtext-lexical": "catalog:payload",
    "@payloadcms/storage-s3": "catalog:payload",
    "@payloadcms/translations": "catalog:payload",
    "@payloadcms/ui": "catalog:payload",
    "cn": "catalog:",
    "lucide-react": "catalog:",
    "next": "catalog:",
    "payload": "catalog:payload",
    "react": "catalog:",
    "react-dom": "catalog:"
  },
  "devDependencies": {
    "@homestuck/tsconfig": "workspace:^",
    "@payloadcms/typescript-plugin": "catalog:payload"
  },
  "peerDependencies": {
    "@payloadcms/db-mongodb": "catalog:payload",
    "@payloadcms/ui": "catalog:payload",
    "payload": "catalog:payload",
    "react": "catalog:",
    "react-dom": "catalog:"
  },
  "watch": {
    "generate:types": {
      "patterns": [
        "src"
      ],
      "extensions": "ts,tsx",
      "quiet": false
    }
  }
}
