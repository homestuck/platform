{
  "$schema": "https://turborepo.dev/schema.json",
  "globalDependencies": ["**/.env", "**/.env.development", "**/.env.prod"],
  "globalEnv": ["CI", "NODE_ENV", "SKIP_ENV_VALIDATION", "npm_lifecycle_event"],
  "remoteCache": {
    "enabled": false
  },
  "tasks": {
    "//#clean": {
      "cache": false
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": [
        ".next/**",
        "!.next/cache/**",
        "next-env.d.ts",
        ".expo/**",
        ".output/**",
        ".vercel/output/**",
        "storybook-static/**",
        "dist/**"
      ]
    },
    "clean": {
      "cache": false
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "//#format": {
      "dependsOn": ["^topo"],
      "outputLogs": "new-only",
      "outputs": ["node_modules/.cache/.oxfmtcache"]
    },
    "//#format:fix": {
      "dependsOn": ["//#lint:fix", "^topo"],
      "cache": false
    },
    "//#lint": {
      "dependsOn": ["^topo"],
      "outputs": ["node_modules/.cache/.oxlintcache"]
    },
    "//#lint:fix": {
      "dependsOn": ["^topo"],
      "cache": false
    },
    "precommit": {
      "cache": false,
      "dependsOn": ["^topo"]
    },
    "storybook": {
      "cache": false,
      "persistent": true
    },
    "topo": {
      "dependsOn": ["^topo"]
    },
    "typecheck": {
      "dependsOn": ["^topo"],
      "outputs": ["node_modules/.cache/tsbuildinfo.json"]
    }
  },
  "ui": "tui"
}
